msgid "%d overlapping client observations hidden"
msgstr "已隐藏 %d 条重复的客户端观测"

msgid "%d seconds ago"
msgstr "%d 秒前"

msgid "A BSSID is already used by this device or another peer on this profile."
msgstr "本机或其他 Mesh 节点已在此漫游配置中使用该 BSSID。"

msgid "A local profile selects an SSID on this AP. Use the same stable profile ID on the other APs for the same network."
msgstr "本地配置选择本机的一个 SSID。同一网络在其他 AP 上应使用相同的固定配置标识。"

