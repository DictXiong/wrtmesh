#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
mesh_announce() {
 local mac host
 [ -r /sys/class/net/br-lan/address ] && read -r mac < /sys/class/net/br-lan/address || return 0
 host=xr-$(printf '%s' "$mac" | tr -d :)
 procd_open_data
 json_add_object mdns
 json_add_object xrmesh
 json_add_string instance "$host"
 json_add_string hostname "$host.local"
 json_add_string service _xr-roaming._tcp.local
 json_add_int port 80
 json_close_object
 json_close_object
 procd_close_data
}
start_service() {
 local profile profiles
 profiles=$(/usr/lib/xr-roaming/helper.sh profiles) || return 1
 if [ -x /usr/lib/xr-roaming/mesh-daemon.sh ]; then
  procd_open_instance mesh-observer
  procd_set_param command /usr/lib/xr-roaming/mesh-daemon.sh
  procd_set_param respawn 3600 5 5
  procd_set_param term_timeout 5
  mesh_announce
  procd_close_instance
 fi
 for profile in $profiles; do
  [ "$(uci -q get xr_roaming.$profile.enabled)" = 1 ] || continue
  # The daemon validates its tools/config and takes its own exclusive lock.
  # Preflight here would race a running instance during declarative reload.
  procd_open_instance "$profile"
  procd_set_param command /usr/lib/xr-roaming/helper.sh daemon "$profile"
  procd_set_param respawn 3600 5 5
  procd_set_param term_timeout 15
  procd_set_param stdout 0
  procd_set_param stderr 1
  procd_close_instance
 done
}
# Reconcile the declared instances through procd: unchanged running instances
# keep their PID, newly enabled/dead instances start, omitted instances stop.
# This does not reload wireless or restart healthy metadata workers.
reload_service() {
 local state=/tmp/xr-roaming-private token temp
 if [ -d "$state" ] && [ ! -L "$state" ]; then
  umask 077
  [ "$(ls -nd "$state" | awk '{print $3}')" = 0 ] && chmod 700 "$state" || return 1
  temp=$state/reload.token.$$
  [ ! -e "$temp" ] && [ ! -L "$temp" ] || return 1
  IFS= read -r token < /proc/sys/kernel/random/uuid || return 1
  printf '%s\n' "$token" > "$temp" && mv "$temp" "$state/reload.token" || return 1
 fi
 start
}
service_triggers() {
 procd_add_reload_trigger xr_roaming xr_mesh
 procd_add_reload_interface_trigger lan
}
